<div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
  <div><p class="text-xs font-bold uppercase tracking-[0.18em] text-[#b84332]">HaNCON website</p><h1 class="mt-2 font-serif text-4xl font-semibold text-[#173e35]">Content overview</h1><p class="mt-2 text-[#64746c]">Create and update what the community sees on the website.</p></div>
  <%= link_to "Open public site ↗", root_path, class: "text-sm font-bold text-[#17483e]" %>
</div>

<div class="mt-8 grid gap-5 md:grid-cols-3">
  <% [["News & updates", NewsPost.count, admin_news_posts_path, "Write an update"], ["Events", Event.count, admin_events_path, "Add an event"], ["Photo galleries", Gallery.count, admin_galleries_path, "Create a gallery"]].each do |title, count, path, action| %>
    <%= link_to path, class: "rounded-2xl border border-[#e2e5dc] bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md" do %>
      <p class="text-sm font-semibold text-[#718078]"><%= title %></p><p class="mt-3 text-4xl font-bold text-[#173e35]"><%= count %></p><p class="mt-5 text-sm font-bold text-[#b84332]"><%= action %> <span aria-hidden="true">→</span></p>
    <% end %>
  <% end %>
</div>

<div class="mt-10 grid gap-8 lg:grid-cols-3">
  <section><div class="flex items-center justify-between"><h2 class="text-lg font-bold text-[#173e35]">Recently updated news</h2><%= link_to "All news", admin_news_posts_path, class: "text-sm font-bold text-[#b84332]" %></div><div class="mt-4 divide-y divide-[#e2e5dc] rounded-2xl border border-[#e2e5dc] bg-white px-5"><% @news_posts.each do |post| %><div class="py-4"><p class="font-semibold"><%= post.title %></p><p class="mt-1 text-xs text-[#718078]"><%= post.published? ? "Published" : "Draft" %> · Updated <%= time_ago_in_words(post.updated_at) %> ago</p></div><% end %><% if @news_posts.empty? %><p class="py-5 text-sm text-[#718078]">No news yet.</p><% end %></div></section>
  <section><div class="flex items-center justify-between"><h2 class="text-lg font-bold text-[#173e35]">Events</h2><%= link_to "All events", admin_events_path, class: "text-sm font-bold text-[#b84332]" %></div><div class="mt-4 divide-y divide-[#e2e5dc] rounded-2xl border border-[#e2e5dc] bg-white px-5"><% @events.each do |event| %><div class="py-4"><p class="font-semibold"><%= event.title %></p><p class="mt-1 text-xs text-[#718078]"><%= event.starts_at.strftime("%b %-d, %Y · %l:%M %p") %> · <%= event.published? ? "Published" : "Draft" %></p></div><% end %><% if @events.empty? %><p class="py-5 text-sm text-[#718078]">No events yet.</p><% end %></div></section>
  <section><div class="flex items-center justify-between"><h2 class="text-lg font-bold text-[#173e35]">Galleries</h2><%= link_to "All galleries", admin_galleries_path, class: "text-sm font-bold text-[#b84332]" %></div><div class="mt-4 divide-y divide-[#e2e5dc] rounded-2xl border border-[#e2e5dc] bg-white px-5"><% @galleries.each do |gallery| %><div class="py-4"><p class="font-semibold"><%= gallery.title %></p><p class="mt-1 text-xs text-[#718078]"><%= pluralize(gallery.photos.count, "photo") %> · <%= gallery.published? ? "Published" : "Draft" %></p></div><% end %><% if @galleries.empty? %><p class="py-5 text-sm text-[#718078]">No galleries yet.</p><% end %></div></section>
</div>
