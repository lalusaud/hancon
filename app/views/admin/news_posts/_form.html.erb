<%= form_with model: [:admin, @news_post], class: "space-y-6" do |form| %>
  <% if @news_post.errors.any? %><div class="rounded-xl bg-red-50 p-4 text-sm text-red-800"><%= @news_post.errors.full_messages.to_sentence %></div><% end %>
  <div><%= form.label :title, class: "mb-2 block text-sm font-bold" %><%= form.text_field :title, required: true, class: "w-full rounded-xl border border-[#d4ddd5] bg-white px-4 py-3" %></div>
  <div><%= form.label :slug, "URL slug (optional)", class: "mb-2 block text-sm font-bold" %><%= form.text_field :slug, class: "w-full rounded-xl border border-[#d4ddd5] bg-white px-4 py-3" %></div>
  <div><%= form.label :excerpt, class: "mb-2 block text-sm font-bold" %><%= form.text_area :excerpt, rows: 2, class: "w-full rounded-xl border border-[#d4ddd5] bg-white px-4 py-3" %></div>
  <div><%= form.label :body, "Article", class: "mb-2 block text-sm font-bold" %><%= form.rich_text_area :body, class: "min-h-72 w-full rounded-xl border border-[#d4ddd5] bg-white px-4 py-3" %><p class="mt-2 text-xs text-[#718078]">Use the toolbar to format text, add links, or insert images into the article.</p></div>
  <div><%= form.label :published_at, class: "mb-2 block text-sm font-bold" %><%= form.datetime_local_field :published_at, class: "rounded-xl border border-[#d4ddd5] bg-white px-4 py-3" %></div>
  <div><label class="flex items-center gap-3 text-sm font-semibold"><%= form.check_box :published, class: "h-4 w-4 rounded border-[#a9beb0] text-[#17483e]" %> Publish this update</label><p class="ml-7 mt-1 text-xs text-[#718078]">Published updates appear in the homepage News &amp; Updates section.</p></div>
  <div class="flex gap-3"><%= form.submit class: "rounded-full bg-[#17483e] px-6 py-3 text-sm font-bold text-white" %><%= link_to "Cancel", admin_news_posts_path, class: "rounded-full border border-[#d4ddd5] px-6 py-3 text-sm font-bold" %></div>
<% end %>
