<div class="flex items-end justify-between gap-4"><div><p class="text-xs font-bold uppercase tracking-[0.18em] text-[#b84332]">Publishing</p><h1 class="mt-2 font-serif text-4xl font-semibold text-[#173e35]">News &amp; updates</h1></div><%= link_to "New update +", new_admin_news_post_path, class: "rounded-full bg-[#17483e] px-5 py-3 text-sm font-bold text-white" %></div>
<p class="mt-5 text-sm text-[#64746c]">Only published news appears on the homepage. Drafts stay private until you publish them. Publishing makes an update visible immediately.</p>
<div class="mt-4 overflow-hidden rounded-2xl border border-[#e2e5dc] bg-white"><table class="w-full text-left text-sm"><thead class="bg-[#f7f7f2] text-xs uppercase tracking-wider text-[#718078]"><tr><th class="px-5 py-4">Title</th><th class="px-5 py-4">Status</th><th class="px-5 py-4">Updated</th><th class="px-5 py-4 text-right">Actions</th></tr></thead><tbody class="divide-y divide-[#e2e5dc]"><% @news_posts.each do |post| %><tr><td class="px-5 py-4 font-semibold"><%= post.title %></td><td class="px-5 py-4"><% if post.published? %><span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-800">Published</span><% else %><span class="rounded-full bg-amber-50 px-3 py-1 text-xs font-bold text-amber-800">Draft</span><% end %></td><td class="px-5 py-4 text-[#718078]"><%= post.updated_at.strftime("%b %-d, %Y") %></td><td class="px-5 py-4 text-right"><%= link_to "Edit", edit_admin_news_post_path(post), class: "font-bold text-[#17483e]" %><% unless post.published? %> <%= button_to "Publish", publish_admin_news_post_path(post), method: :patch, form: { class: "ml-3 inline" }, class: "font-bold text-[#17483e]" %><% end %> <%= button_to "Delete", admin_news_post_path(post), method: :delete, form: { class: "ml-3 inline" }, class: "font-bold text-[#b84332]", data: { turbo_confirm: "Delete this update?" } %></td></tr><% end %><% if @news_posts.empty? %><tr><td colspan="4" class="px-5 py-10 text-center text-[#718078]">No news updates yet. Create the first one.</td></tr><% end %></tbody></table></div>
