<%= form_with model: [:admin, @gallery], class: "space-y-6" do |form| %>
  <% if @gallery.errors.any? %><div class="rounded-xl bg-red-50 p-4 text-sm text-red-800"><%= @gallery.errors.full_messages.to_sentence %></div><% end %>
  <div><%= form.label :title, class: "mb-2 block text-sm font-bold" %><%= form.text_field :title, required: true, class: "w-full rounded-xl border border-[#d4ddd5] bg-white px-4 py-3" %></div>
  <div><%= form.label :description, class: "mb-2 block text-sm font-bold" %><%= form.text_area :description, rows: 4, class: "w-full rounded-xl border border-[#d4ddd5] bg-white px-4 py-3" %></div>
  <div data-controller="image-resize">
    <%= form.label :photos, "Add photos", class: "mb-2 block text-sm font-bold" %>
    <%= form.file_field :photos, multiple: true, include_hidden: false, accept: "image/jpeg,image/png,image/webp", direct_upload: true, data: { image_resize_target: "input", action: "change->image-resize#resize" }, class: "block w-full rounded-xl border border-[#d4ddd5] bg-white px-4 py-3 text-sm" %>
    <p class="mt-2 text-xs text-[#718078]">New photos will be added to this gallery and resized to a maximum of 1200px. The first uploaded photo becomes the gallery thumbnail; you can change it below after saving.</p>
    <p class="mt-1 text-xs text-[#718078]" data-image-resize-target="status" aria-live="polite"></p>
  </div>
  <% if @gallery.photos.attached? %>
    <div>
      <p class="mb-3 text-sm font-bold">Current photos</p>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
        <% @gallery.photos_attachments.includes(:blob).each do |photo_attachment| %>
          <div class="rounded-xl border border-[#e2e5dc] bg-white p-2">
            <%= image_tag photo_attachment.blob.variant(resize_to_limit: [480, 360]), loading: "lazy", class: "h-24 w-full rounded-lg object-cover" %>
            <label class="mt-2 flex cursor-pointer items-center gap-2 text-xs font-semibold text-[#17483e]">
              <%= radio_button_tag "gallery[featured_photo_attachment_id]", photo_attachment.id, @gallery.featured_photo_attachment_id == photo_attachment.id || (@gallery.featured_photo_attachment_id.blank? && photo_attachment == @gallery.photos_attachments.first), class: "h-4 w-4 border-[#a9beb0] text-[#17483e]" %>
              Gallery thumbnail
            </label>
            <label class="mt-2 flex cursor-pointer items-center gap-2 text-xs font-semibold text-[#9b3a2d]">
              <%= check_box_tag "gallery[remove_photo_attachment_ids][]", photo_attachment.id, false, class: "h-4 w-4 rounded border-[#d4aaa4] text-[#b84332]" %>
              Remove photo
            </label>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
  <label class="flex items-center gap-3 text-sm font-semibold"><%= form.check_box :published, class: "h-4 w-4 rounded border-[#a9beb0] text-[#17483e]" %> Publish this gallery</label>
  <div class="flex gap-3"><%= form.submit class: "rounded-full bg-[#17483e] px-6 py-3 text-sm font-bold text-white" %><%= link_to "Cancel", admin_galleries_path, class: "rounded-full border border-[#d4ddd5] px-6 py-3 text-sm font-bold" %></div>
<% end %>
