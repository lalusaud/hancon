<div class="flex items-end justify-between gap-4"><div><p class="text-xs font-bold uppercase tracking-[0.18em] text-[#b84332]">Community moments</p><h1 class="mt-2 font-serif text-4xl font-semibold text-[#173e35]">Photo galleries</h1></div><%= link_to "New gallery +", new_admin_gallery_path, class: "rounded-full bg-[#17483e] px-5 py-3 text-sm font-bold text-white" %></div>
<div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3"><% @galleries.each do |gallery| %><article class="overflow-hidden rounded-2xl border border-[#e2e5dc] bg-white"><% if gallery.photos.attached? %><%= image_tag gallery.featured_photo.variant(resize_to_limit: [480, 360]), loading: "lazy", class: "h-48 w-full object-cover" %><% else %><div class="flex h-48 items-center justify-center bg-[#e3eee5] text-4xl text-[#75927e]" aria-hidden="true">▧</div><% end %><div class="p-5"><h2 class="font-bold"><%= gallery.title %></h2><p class="mt-1 text-sm text-[#718078]"><%= pluralize(gallery.photos.count, "photo") %> · <%= gallery.published? ? "Published" : "Draft" %></p><div class="mt-4 flex items-center gap-4"><%= link_to "Edit", edit_admin_gallery_path(gallery), class: "text-sm font-bold text-[#17483e]" %><%= button_to "Delete", admin_gallery_path(gallery), method: :delete, class: "text-sm font-bold text-[#b84332]", data: { turbo_confirm: "Delete this gallery and its photos?" } %></div></div></article><% end %><% if @galleries.empty? %><div class="rounded-2xl border border-dashed border-[#c8d2c8] p-10 text-center text-[#718078] sm:col-span-2 lg:col-span-3">No galleries yet. Create one and upload photos.</div><% end %></div>
