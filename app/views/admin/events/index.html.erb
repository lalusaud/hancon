<div class="flex items-end justify-between gap-4"><div><p class="text-xs font-bold uppercase tracking-[0.18em] text-[#b84332]">What’s happening</p><h1 class="mt-2 font-serif text-4xl font-semibold text-[#173e35]">Events</h1></div><%= link_to "New event +", new_admin_event_path, class: "rounded-full bg-[#17483e] px-5 py-3 text-sm font-bold text-white" %></div>
<div class="mt-8 overflow-hidden rounded-2xl border border-[#e2e5dc] bg-white"><table class="w-full text-left text-sm"><thead class="bg-[#f7f7f2] text-xs uppercase tracking-wider text-[#718078]"><tr><th class="px-5 py-4">Event</th><th class="px-5 py-4">Date</th><th class="px-5 py-4">Status</th><th class="px-5 py-4 text-right">Actions</th></tr></thead><tbody class="divide-y divide-[#e2e5dc]"><% @events.each do |event| %><tr><td class="px-5 py-4 font-semibold"><%= event.title %></td><td class="px-5 py-4"><%= event.starts_at.strftime("%b %-d, %Y · %l:%M %p") %></td><td class="px-5 py-4"><%= event.published? ? "Published" : "Draft" %></td><td class="px-5 py-4 text-right"><%= link_to "Edit", edit_admin_event_path(event), class: "font-bold text-[#17483e]" %> <%= button_to "Delete", admin_event_path(event), method: :delete, form: { class: "ml-3 inline" }, class: "font-bold text-[#b84332]", data: { turbo_confirm: "Delete this event?" } %></td></tr><% end %><% if @events.empty? %><tr><td colspan="4" class="px-5 py-10 text-center text-[#718078]">No events yet. Add an upcoming program or event.</td></tr><% end %></tbody></table></div>
