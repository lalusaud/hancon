<% content_for :title, "HaNCON | About us" %>
<% content_for :header_theme, "dark" %>
<% content_for :meta_description, "Learn about HaNCON: our story, mission, and vision for preserving Nepalese culture and empowering the Nepali-speaking community in Hamilton, Canada." %>

<main>
  <section class="pb-16 pt-8 lg:pb-20 lg:pt-12">
    <div class="mx-auto max-w-7xl px-6 lg:px-10">
      <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/25 bg-[#0a1f1b]/45 px-4 py-2 text-xs font-bold uppercase tracking-[0.16em] text-[#f2d9a8] backdrop-blur-sm"><span class="h-2 w-2 rounded-full bg-[#e7b85f]"></span> About HaNCON</p>
      <h1 class="max-w-3xl font-serif text-5xl font-semibold leading-[1.04] tracking-[-0.04em] text-white sm:text-6xl">Who we are &amp; <span class="text-[#e7b85f]">why we exist.</span></h1>
      <p class="mt-7 max-w-2xl text-lg leading-8 text-[#e1e9e4]">Established in 2023, the Hamilton Nepali Community Organization And Network (HaNCON) is a not-for-profit organization preserving Nepalese culture while empowering individuals and families across the Greater Hamilton Area.</p>
    </div>
  </section>

  <section class="bg-[#fbf8f2] py-14 text-[#182c29] lg:py-20">
    <div class="mx-auto max-w-7xl space-y-10 px-6 lg:px-10">
      <section>
        <h2 class="font-serif text-3xl font-semibold tracking-[-0.03em] text-[#173e35]">Objectives of HaNCON:</h2>
        <ul class="mt-5 list-disc space-y-3 pl-6 text-lg leading-8 text-[#53645c]">
          <li>Fostering the development of a united and welcoming community</li>
          <li>Offering networking avenues for its members (not limited to new commers and students)</li>
          <li>Advocating for the propagation of Nepali culture and values in Hamilton and region</li>
          <li>Implementing educational (Nepali school) and healthcare initiatives (blood donation) for the community</li>
          <li>Collaborating with global organizations to enhance coordination</li>
        </ul>
      </section>

      <section>
        <h2 class="font-serif text-3xl font-semibold tracking-[-0.03em] text-[#173e35]">Mission:</h2>
        <p class="mt-4 text-lg leading-8 text-[#53645c]">HaNCON’s mission is to create a harmonious, inclusive and equitable community where Nepali speaking Hamiltonians common interest is represented.</p>
      </section>

      <section>
        <h2 class="font-serif text-3xl font-semibold tracking-[-0.03em] text-[#173e35]">Vision:</h2>
        <p class="mt-4 text-lg leading-8 text-[#53645c]">Our vision is to unite individuals of Nepali-speaking population in Hamilton under a shared platform, fostering an atmosphere of friendship, mutual understanding, cooperation, and respect. We aspire to create a cohesive community where members actively support each other in times of need, standing together under a single umbrella.</p>
      </section>
    </div>
  </section>
</main>
