<% content_for :title, "HaNCON | Programs" %>
<% content_for :header_theme, "dark" %>
<% content_for :meta_description, "Community programs from HaNCON that keep Nepali culture vibrant and create opportunities for every generation." %>

<main>
  <section class="pb-16 pt-8 lg:pb-20 lg:pt-12">
    <div class="mx-auto max-w-7xl px-6 lg:px-10">
      <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/25 bg-[#0a1f1b]/45 px-4 py-2 text-xs font-bold uppercase tracking-[0.16em] text-[#f2d9a8] backdrop-blur-sm"><span class="h-2 w-2 rounded-full bg-[#e7b85f]"></span> Learn, connect, thrive</p>
      <h1 class="max-w-3xl font-serif text-5xl font-semibold leading-[1.04] tracking-[-0.04em] text-white sm:text-6xl">Growing together.</h1>
      <p class="mt-7 max-w-2xl text-lg leading-8 text-[#e1e9e4]">Community-led programs that keep culture vibrant and create opportunities for every generation.</p>
    </div>
  </section>

  <section class="bg-[#fbf8f2] py-14 text-[#182c29] lg:py-20">
    <div class="mx-auto max-w-7xl px-6 lg:px-10">
      <h2 class="font-serif text-3xl font-semibold tracking-[-0.03em] text-[#173e35]">Our programs</h2>
      <div class="mt-8 grid gap-x-14 md:grid-cols-2">
        <article class="border-t border-[#d9dfd7] py-6">
          <h3 class="text-xl font-bold text-[#173e35]">Culture &amp; Heritage</h3>
          <p class="mt-3 text-lg leading-7 text-[#53645c]">Celebrating Nepalese traditions, languages, and festivals.</p>
        </article>
        <article class="border-t border-[#d9dfd7] py-6">
          <h3 class="text-xl font-bold text-[#173e35]">Social Inclusion</h3>
          <p class="mt-3 text-lg leading-7 text-[#53645c]">Creating supportive spaces for youth, women, and seniors.</p>
        </article>
        <article class="border-t border-[#d9dfd7] py-6">
          <h3 class="text-xl font-bold text-[#173e35]">Capacity &amp; Empowerment</h3>
          <p class="mt-3 text-lg leading-7 text-[#53645c]">Building skills, mentorship, and leadership opportunities.</p>
        </article>
        <article class="border-t border-[#d9dfd7] py-6">
          <h3 class="text-xl font-bold text-[#173e35]">Community Engagement</h3>
          <p class="mt-3 text-lg leading-7 text-[#53645c]">Working with local partners for diversity, equity, and impact.</p>
        </article>
      </div>

      <section aria-labelledby="nepali-language-class" class="relative isolate mt-14 overflow-hidden rounded-[1.75rem] bg-[#17483e] text-white shadow-[0_30px_80px_-45px_rgba(23,62,53,0.55)]">
        <div aria-hidden="true" class="pointer-events-none absolute inset-0 opacity-[0.14]">
          <svg class="absolute right-[6%] top-6 h-16 w-16 -rotate-6" viewBox="0 0 80 80" fill="none" stroke="#e7b85f" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 29 62 20v35l-44 9z"/><path d="M18 29v35m44-44v35M25 27v34m30-40v34M18 38l44-9M18 49l44-9"/><ellipse cx="18" cy="46.5" rx="5" ry="17.5"/><ellipse cx="62" cy="37.5" rx="5" ry="17.5"/></svg>
          <svg class="absolute left-[48%] -bottom-8 h-16 w-16" viewBox="0 0 96 96" fill="none" stroke="#e7b85f" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m8 72 27-35 16 20 14-27 23 42H8Z"/><path d="m28 47 7-10 9 11m15 1 6-19 12 22"/><path d="M8 78h80"/></svg>
        </div>
        <div aria-hidden="true" class="pointer-events-none absolute -right-24 -top-24 h-64 w-64 rounded-full border border-[#e7b85f]/25"></div>
        <div class="relative z-10 grid items-center gap-12 p-8 sm:p-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
          <div>
            <p class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.18em] text-[#e7b85f]"><span class="h-2 w-2 rounded-full bg-[#e7b85f]"></span> Featured program · Learning</p>
            <h3 id="nepali-language-class" class="mt-5 font-serif text-2xl font-semibold leading-[1.08] tracking-[-0.03em] whitespace-nowrap sm:text-[2.1rem]">Nepali Language Class</h3>
            <p class="mt-3 font-serif text-xl text-[#f2d9a8]">नेपाली भाषा, संस्कृति र समाज</p>
            <p class="mt-6 max-w-lg leading-7 text-[#d0ded6]">Since 2025, HaNCON has been partnering with Hamilton Nepali School, helping young learners connect with language, culture, and community.</p>
          </div>
          <div class="relative">
            <div class="overflow-hidden rounded-[1.5rem] border border-white/15 bg-[#123f37]">
              <%= image_tag "/images/nepali_class.jpg", alt: "Young learners at a HaNCON Nepali language class", class: "block h-[240px] w-full object-cover sm:h-[340px]" %>
            </div>
            <div class="absolute -bottom-5 left-8 rounded-2xl bg-[#e7b85f] px-5 py-3 shadow-lg"><p class="font-serif text-lg font-semibold text-[#173e35]">नमस्ते</p><p class="text-[10px] font-bold uppercase tracking-[0.14em] text-[#4c5c4d]">Welcome</p></div>
          </div>
        </div>
      </section>

      <section aria-labelledby="blood-donations" class="relative isolate mt-8 overflow-hidden rounded-[1.75rem] border border-[#eadfc8] bg-[#f0e8d8] text-[#182c29]">
        <div aria-hidden="true" class="pointer-events-none absolute -bottom-24 -left-20 h-64 w-64 rounded-full border-[20px] border-[#e2d3ae]/50"></div>
        <div class="relative z-10 grid items-center gap-12 p-8 sm:p-12 lg:grid-cols-[1fr_1.1fr] lg:gap-16">
          <div class="relative order-2 lg:order-1">
            <div class="overflow-hidden rounded-[1.5rem] border border-[#e3d5b6] bg-[#faf3e6]">
              <svg viewBox="0 0 420 340" fill="none" aria-hidden="true" class="mx-auto block h-[240px] w-full sm:h-[340px]">
                <defs>
                  <linearGradient id="bd-ink" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0" stop-color="#b84332"/>
                    <stop offset="1" stop-color="#93362a"/>
                  </linearGradient>
                </defs>
                <g stroke="url(#bd-ink)" stroke-width="2" stroke-opacity=".5" stroke-dasharray="1 8" stroke-linecap="round">
                  <circle cx="210" cy="188" r="116"/>
                  <circle cx="74" cy="72" r="26"/>
                </g>
                <path d="M210 92c-36 46-58 78-58 106a58 58 0 0 0 116 0c0-28-22-60-58-106Z" fill="#b84332" fill-opacity=".08" stroke="url(#bd-ink)" stroke-width="3" stroke-linejoin="round"/>
                <path d="M170 206h14l9-16 12 30 11-14h34" stroke="url(#bd-ink)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                <g stroke="url(#bd-ink)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M64 156c-7 9-11 15-11 21a11 11 0 0 0 22 0c0-6-4-12-11-21Z"/>
                  <path d="M356 216c-7 9-11 15-11 21a11 11 0 0 0 22 0c0-6-4-12-11-21Z"/>
                  <path d="M74 72l2.2 5.6 5.6 2.2-5.6 2.2-2.2 5.6-2.2-5.6-5.6-2.2 5.6-2.2z"/>
                  <path d="M348 100l1.8 4.5 4.6 1.8-4.6 1.8-1.8 4.5-1.8-4.5-4.5-1.8 4.5-1.8z"/>
                </g>
                <path d="M146 300c-6-10-16-6-16 2 0 7 9 12 16 18 7-6 16-11 16-18 0-8-10-12-16-2Z" fill="#b84332" fill-opacity=".85"/>
                <path d="M210 306c-6-10-16-6-16 2 0 7 9 12 16 18 7-6 16-11 16-18 0-8-10-12-16-2Z" fill="#17483e" fill-opacity=".85"/>
                <path d="M274 300c-6-10-16-6-16 2 0 7 9 12 16 18 7-6 16-11 16-18 0-8-10-12-16-2Z" fill="#e7b85f" fill-opacity=".9"/>
              </svg>
            </div>
            <div class="absolute -bottom-5 left-8 rounded-2xl bg-[#17483e] px-5 py-3 shadow-[0_18px_40px_-20px_rgba(23,62,53,0.5)]"><p class="font-serif text-lg font-semibold text-white">♥</p><p class="text-[10px] font-bold uppercase tracking-[0.14em] text-[#c8d8d0]">Saving lives together</p></div>
          </div>
          <div class="order-1 lg:order-2">
            <p class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.18em] text-[#b84332]"><span class="h-2 w-2 rounded-full bg-[#b84332]"></span> Featured program · Health</p>
            <h3 id="blood-donations" class="mt-5 font-serif text-2xl font-semibold leading-[1.08] tracking-[-0.03em] whitespace-nowrap text-[#173e35] sm:text-[2.1rem]">Blood Donations</h3>
            <p class="mt-6 max-w-lg leading-7 text-[#53645c]">HaNCON has been proudly partnering with Nepalese Blood Donors Association (NBDA-Canada) to support blood donation drives in our communities. Together we are committed to saving lives and making a meaningful difference through this life-saving initiative.</p>
          </div>
        </div>
      </section>
    </div>
  </section>
</main>
