<% content_for :title, "HaNCON | A community that feels like home" %>
<% content_for :head do %>
  <meta name="description" content="HaNCON brings Hamilton's Nepali-speaking community together through culture, connection, learning, and community programs.">
<% end %>

<div class="w-full bg-[#fbf8f2] text-[#182c29]">
  <main id="home">
    <section class="mx-auto grid max-w-7xl gap-12 px-6 pb-20 pt-10 lg:grid-cols-[1fr_0.95fr] lg:items-center lg:px-10 lg:pb-28 lg:pt-14">
      <div class="max-w-2xl">
        <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-[#dfd8ca] bg-white/70 px-4 py-2 text-xs font-bold uppercase tracking-[0.16em] text-[#8c4a37]"><span class="h-2 w-2 rounded-full bg-[#d59a38]"></span> Rooted in culture. Growing together.</p>
        <h1 class="font-serif text-5xl font-semibold leading-[1.04] tracking-[-0.04em] text-[#173e35] sm:text-6xl lg:text-7xl">A community that feels like <span class="text-[#b84332]">home.</span></h1>
        <p class="mt-7 max-w-xl text-lg leading-8 text-[#53645c]">HaNCON brings Hamilton’s Nepali-speaking community together to celebrate our heritage, support one another, and thrive in Canada’s multicultural community.</p>
        <div class="mt-9 flex flex-wrap gap-4">
          <a href="#about" class="rounded-full bg-[#b84332] px-6 py-4 text-sm font-bold text-white shadow-sm transition hover:bg-[#9f3528]">Discover HaNCON <span aria-hidden="true">→</span></a>
          <a href="#programs" class="rounded-full border border-[#c9d0c7] bg-white/60 px-6 py-4 text-sm font-bold text-[#17483e] transition hover:border-[#17483e]">Explore programs</a>
        </div>
        <div class="mt-12 flex items-center gap-4 border-t border-[#e6dfd3] pt-6">
          <div class="flex -space-x-2" aria-hidden="true">
            <span class="h-9 w-9 rounded-full border-2 border-[#fbf8f2] bg-[#d9a16f]"></span><span class="h-9 w-9 rounded-full border-2 border-[#fbf8f2] bg-[#789b82]"></span><span class="h-9 w-9 rounded-full border-2 border-[#fbf8f2] bg-[#bd6c54]"></span>
          </div>
          <p class="text-sm text-[#64746c]">A welcoming place for every generation</p>
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-xl lg:max-w-none">
        <div class="absolute -right-3 -top-5 h-28 w-28 rounded-full border border-[#d8bd8b] lg:-right-5 lg:-top-8 lg:h-36 lg:w-36"></div>
        <div class="relative overflow-hidden rounded-[2rem] bg-[#dce8d9] shadow-[0_25px_70px_-35px_rgba(23,62,53,0.45)]">
          <div class="absolute inset-0 bg-gradient-to-br from-[#eff2dd] via-[#c7ddc9] to-[#749d86]"></div>
          <svg class="relative block h-[390px] w-full sm:h-[470px]" viewBox="0 0 640 560" role="img" aria-labelledby="hero-art-title" xmlns="http://www.w3.org/2000/svg">
            <title id="hero-art-title">Illustration of a welcoming community gathering beneath the Himalayan hills</title>
            <circle cx="474" cy="111" r="54" fill="#E7B85F" opacity=".9"/>
            <path d="M0 278 124 148l85 91 91-135 121 161 70-81 149 123v253H0z" fill="#729181"/>
            <path d="m209 239 91-135 58 77-42-18-23 25-30-12-27 31-27-7zM124 148l48 51-35-12-24 18-23-7zM491 265l70-81 55 47-34-12-19 20-25-5-20 20z" fill="#F2EBDD"/>
            <g aria-label="Himalayan prayer flags" transform="translate(54 84)">
              <path d="M0 0Q78 22 164 5" fill="none" stroke="#725f48" stroke-width="2" opacity=".8"/>
              <path d="M12 3 31 8 18 29z" fill="#2875B9"/>
              <path d="M39 9 58 12 45 34z" fill="#F7F4E9"/>
              <path d="M66 14 85 16 72 39z" fill="#D7433E"/>
              <path d="M94 17 113 17 100 41z" fill="#3E9B69"/>
              <path d="M122 16 141 14 128 38z" fill="#E8B83F"/>
            </g>
            <path d="M0 336c92-45 170-49 253-18 91 35 154 40 236 3 57-26 103-27 151-8v247H0z" fill="#426C58"/>
            <path d="M0 402c104-35 175-10 258 30 90 44 179 42 250-2 48-29 91-37 132-29v159H0z" fill="#285647"/>
            <path d="M0 476c110-27 187-16 272 23 86 40 181 40 267-4 43-22 72-31 101-30v84H0z" fill="#17483E"/>
            <g transform="translate(200 303)">
              <path d="M-42 75c4-43 26-68 52-68s48 25 52 68v92h-104z" fill="#B84332"/><circle cy="-8" r="29" fill="#8A543B"/><path d="M-31-14c4-29 19-44 41-38 15 4 23 16 22 36-14-6-28-13-40-23-5 12-13 21-23 25z" fill="#202E28"/>
              <path d="M-42 70-83 123l-23-17 45-61M42 70l42 52 23-17-45-62" fill="#D9A16F"/>
            </g>
            <g transform="translate(328 321)">
              <path d="M-38 67c3-39 22-61 46-61s43 22 46 61v88h-92z" fill="#E7B85F"/><circle cy="-13" r="27" fill="#B97852"/><path d="M-28-22c6-22 20-33 37-28 12 3 19 14 18 29-16-3-30-10-40-20-2 8-7 15-15 19z" fill="#342C25"/>
              <path d="m-38 61-40 49-20-15 43-57M54 61l40 49 20-15L71 38" fill="#B97852"/>
            </g>
            <g transform="translate(445 313)">
              <path d="M-38 70c4-39 23-62 47-62s43 23 47 62v88h-94z" fill="#E9E3D0"/><circle cy="-11" r="27" fill="#6F4636"/><path d="M-29-19c5-23 18-35 36-31 14 3 21 15 20 33-14-5-28-13-37-23-4 9-10 16-19 21z" fill="#242923"/>
              <path d="m-38 64-37 48-20-15 41-56M56 64l37 48 20-15-41-56" fill="#6F4636"/>
            </g>
            <g fill="#D9A16F"><circle cx="101" cy="414" r="8"/><circle cx="126" cy="430" r="5"/><circle cx="548" cy="405" r="7"/><circle cx="523" cy="429" r="5"/></g>
          </svg>
          <div class="absolute bottom-5 left-5 right-5 flex items-end justify-between gap-4 rounded-2xl border border-white/50 bg-white/80 p-4 backdrop-blur-sm sm:bottom-7 sm:left-7 sm:right-7 sm:p-5">
            <div><p class="text-[10px] font-bold uppercase tracking-[0.17em] text-[#9b533b]">Together in Hamilton</p><p class="mt-1 text-base font-bold text-[#173e35] sm:text-lg">Many stories. One community.</p></div>
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#17483e] text-xl text-white" aria-hidden="true">↗</span>
          </div>
        </div>
        <div class="absolute -bottom-5 -left-5 hidden rounded-2xl bg-[#e7b85f] px-5 py-4 shadow-lg sm:block"><p class="font-serif text-xl font-semibold text-[#173e35]">नमस्ते</p><p class="text-[10px] font-bold uppercase tracking-[0.14em] text-[#4c5c4d]">Welcome</p></div>
      </div>
    </section>

    <% if @events.any? || @news.any? || @galleries.any? %>
      <section class="bg-white py-20 lg:py-24">
        <div class="mx-auto max-w-7xl px-6 lg:px-10">
          <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
            <div><p class="text-xs font-bold uppercase tracking-[0.18em] text-[#b84332]">From our community</p><h2 class="mt-3 font-serif text-4xl font-semibold text-[#173e35]">The latest</h2></div>
            <p class="max-w-lg leading-7 text-[#64746c]">News, upcoming gatherings, and moments shared by the HaNCON community.</p>
          </div>
          <div class="mt-10">
            <div class="grid gap-10 lg:grid-cols-2">
            <% if @events.any? %>
              <div>
                <h3 class="text-xl font-bold text-[#173e35]">Upcoming events</h3>
                <div class="mt-4 grid gap-4">
                  <% @events.each do |event| %>
                    <article class="rounded-2xl border border-[#e2e5dc] bg-[#fbf8f2] p-6">
                      <p class="text-xs font-bold uppercase tracking-[0.14em] text-[#b84332]"><%= event.starts_at.strftime("%b %-d, %Y · %l:%M %p") %></p>
                      <h4 class="mt-3 text-lg font-bold text-[#173e35]"><%= event.title %></h4>
                      <p class="mt-2 text-sm leading-6 text-[#64746c]"><%= event.description %></p>
                      <% if event.location.present? %><p class="mt-4 text-xs font-semibold text-[#53645c]">⌖ <%= event.location %></p><% end %>
                    </article>
                  <% end %>
                </div>
              </div>
            <% end %>

            <% if @news.any? %>
              <div class="<%= @events.any? ? "" : "lg:col-span-2" %>">
                <h3 class="text-xl font-bold text-[#173e35]">News &amp; updates</h3>
                <div class="mt-4 grid gap-4">
                  <% @news.each do |post| %>
                    <article class="rounded-2xl border border-[#e2e5dc] bg-[#fbf8f2] p-6">
                      <p class="text-xs font-bold uppercase tracking-[0.14em] text-[#9b533b]"><%= (post.published_at || post.created_at).strftime("%b %-d, %Y") %></p>
                      <h4 class="mt-3 text-lg font-bold text-[#173e35]"><%= link_to post.title, news_post_path(post.slug), class: "hover:text-[#b84332]" %></h4>
                      <p class="mt-2 text-sm leading-6 text-[#64746c]"><%= post.excerpt.presence || truncate(post.body.to_plain_text, length: 150) %></p>
                      <%= link_to "Read article →", news_post_path(post.slug), class: "mt-4 inline-block text-sm font-bold text-[#17483e]" %>
                    </article>
                  <% end %>
                </div>
              </div>
            <% end %>
            </div>

            <% if @galleries.any? %>
              <div class="mt-12">
                <h3 class="text-xl font-bold text-[#173e35]">Photo galleries</h3>
                <div class="mt-4 grid grid-cols-[repeat(auto-fit,minmax(min(100%,20rem),1fr))] gap-4">
                  <% @galleries.each do |gallery| %>
                    <%= link_to gallery_path(gallery), class: "group overflow-hidden rounded-2xl border border-[#e2e5dc] bg-[#fbf8f2] transition hover:-translate-y-0.5 hover:shadow-md" do %>
                      <% if gallery.photos.attached? %><%= image_tag gallery.photos.first, class: "h-52 w-full object-cover transition group-hover:scale-[1.02]" %><% else %><div class="h-52 bg-[#e3eee5]"></div><% end %>
                      <div class="p-5"><h4 class="font-bold text-[#173e35] group-hover:text-[#b84332]"><%= gallery.title %></h4><p class="mt-1 text-sm text-[#64746c]"><%= gallery.description %></p><span class="mt-4 inline-block text-sm font-bold text-[#17483e]">View gallery →</span></div>
                    <% end %>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </section>
    <% end %>

    <section id="about" class="bg-white py-20 lg:py-24">
      <div class="mx-auto grid max-w-7xl gap-10 px-6 lg:grid-cols-[0.75fr_1.25fr] lg:gap-20 lg:px-10">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-[#b84332]">Who we are</p>
          <h2 class="mt-4 max-w-sm font-serif text-4xl font-semibold leading-tight tracking-[-0.03em] text-[#173e35] sm:text-5xl">A shared place to belong.</h2>
        </div>
        <div class="max-w-3xl">
          <p class="text-lg leading-8 text-[#53645c]">Established in 2023, the Hamilton Nepalese Community Organization &amp; Network (HaNCON) is a not-for-profit organization preserving Nepalese culture while empowering individuals and families across the Greater Hamilton Area.</p>
          <div class="mt-8 grid gap-6 border-t border-[#e7e8e1] pt-7 sm:grid-cols-2">
            <div><p class="text-xs font-bold uppercase tracking-[0.15em] text-[#9b533b]">Our vision</p><p class="mt-2 leading-7 text-[#53645c]">A united Nepali-speaking community built on friendship, mutual understanding, cooperation, and respect.</p></div>
            <div><p class="text-xs font-bold uppercase tracking-[0.15em] text-[#9b533b]">Our mission</p><p class="mt-2 leading-7 text-[#53645c]">To create a harmonious, inclusive, and equitable community where Hamiltonians of Nepali-speaking backgrounds are represented.</p></div>
          </div>
        </div>
      </div>
    </section>

    <section id="programs" class="bg-[#17483e] py-20 text-white lg:py-24">
      <div class="mx-auto max-w-7xl px-6 lg:px-10">
        <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
          <div><p class="text-xs font-bold uppercase tracking-[0.18em] text-[#e7b85f]">Learn, connect, thrive</p><h2 class="mt-4 font-serif text-4xl font-semibold tracking-[-0.03em] sm:text-5xl">Growing together</h2></div>
          <p class="max-w-md leading-7 text-[#d0ded6]">Community-led programs that keep culture vibrant and create opportunities for every generation.</p>
        </div>
        <div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
          <article class="rounded-2xl border border-white/15 bg-white/[0.07] p-6"><span class="text-2xl" aria-hidden="true">◉</span><h3 class="mt-8 text-lg font-bold">Culture &amp; Heritage</h3><p class="mt-3 text-sm leading-6 text-[#c8d8d0]">Celebrating Nepalese traditions, languages, and festivals.</p></article>
          <article class="rounded-2xl border border-white/15 bg-white/[0.07] p-6"><span class="text-2xl" aria-hidden="true">♡</span><h3 class="mt-8 text-lg font-bold">Social Inclusion</h3><p class="mt-3 text-sm leading-6 text-[#c8d8d0]">Creating supportive spaces for youth, women, and seniors.</p></article>
          <article class="rounded-2xl border border-white/15 bg-white/[0.07] p-6"><span class="text-2xl" aria-hidden="true">↗</span><h3 class="mt-8 text-lg font-bold">Capacity &amp; Empowerment</h3><p class="mt-3 text-sm leading-6 text-[#c8d8d0]">Building skills, mentorship, and leadership opportunities.</p></article>
          <article class="rounded-2xl border border-white/15 bg-white/[0.07] p-6"><span class="text-2xl" aria-hidden="true">◎</span><h3 class="mt-8 text-lg font-bold">Community Engagement</h3><p class="mt-3 text-sm leading-6 text-[#c8d8d0]">Working with local partners for diversity, equity, and impact.</p></article>
        </div>
      </div>
    </section>

    <section id="community" class="mx-auto grid max-w-7xl gap-8 px-6 py-20 lg:grid-cols-2 lg:gap-10 lg:px-10 lg:py-24">
      <article class="relative overflow-hidden rounded-[1.75rem] bg-[#f0e8d8] p-8 sm:p-10">
        <div class="absolute -right-8 -top-10 h-48 w-48 rounded-full border-[24px] border-[#dfcfaf]/60"></div>
        <p class="relative text-xs font-bold uppercase tracking-[0.18em] text-[#9b533b]">Programs · Learning</p>
        <h2 class="relative mt-5 max-w-md font-serif text-3xl font-semibold leading-tight tracking-[-0.03em] text-[#173e35] sm:text-4xl">Keep the Nepali language alive, together.</h2>
        <p class="relative mt-5 max-w-lg leading-7 text-[#53645c]">A Nepali Language Class has started in coordination with the Hamilton-Wentworth District School Board (HWDSB), helping young learners connect with language, culture, and community.</p>
        <span class="relative mt-8 inline-flex items-center gap-2 text-sm font-bold text-[#17483e]">A community learning initiative <span aria-hidden="true">↗</span></span>
      </article>
      <article id="contact" class="flex flex-col justify-between rounded-[1.75rem] bg-[#e3eee5] p-8 sm:p-10">
        <div><p class="text-xs font-bold uppercase tracking-[0.18em] text-[#557562]">Come say namaste</p><h2 class="mt-5 max-w-md font-serif text-3xl font-semibold leading-tight tracking-[-0.03em] text-[#173e35] sm:text-4xl">There’s a place for you here.</h2><p class="mt-5 max-w-lg leading-7 text-[#53645c]">Join us in celebrating culture, building connections, and creating a stronger community across Hamilton.</p></div>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="https://www.facebook.com/profile.php?id=61552859024176" target="_blank" rel="noopener noreferrer" class="rounded-full bg-[#17483e] px-6 py-4 text-sm font-bold text-white transition hover:bg-[#10372f]">Connect on Facebook <span aria-hidden="true">↗</span></a>
          <a href="mailto:info@hancon.ca" class="rounded-full border border-[#a9beb0] px-6 py-4 text-sm font-bold text-[#17483e] transition hover:bg-white/70">Contact HaNCON</a>
        </div>
      </article>
    </section>


  </main>

</div>
