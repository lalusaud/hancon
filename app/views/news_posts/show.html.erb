<% content_for :title, "#{@news_post.title} | HaNCON" %>

<section class="bg-[#fbf8f2] px-6 py-10 text-[#182c29] lg:px-10 lg:py-14">
  <article class="mx-auto max-w-3xl">
    <%= link_to "← Back to HaNCON", root_path, class: "text-sm font-bold text-[#17483e] hover:text-[#b84332]" %>
    <p class="mt-10 text-xs font-bold uppercase tracking-[0.16em] text-[#9b533b]"><%= (@news_post.published_at || @news_post.created_at).strftime("%B %-d, %Y") %></p>
    <h1 class="mt-3 font-serif text-4xl font-semibold leading-tight tracking-[-0.03em] text-[#173e35] sm:text-5xl"><%= @news_post.title %></h1>
    <% if @news_post.excerpt.present? %><p class="mt-6 text-xl leading-8 text-[#53645c]"><%= @news_post.excerpt %></p><% end %>
    <div class="trix-content mt-10 text-base leading-8 text-[#354b43]">
      <%= @news_post.body %>
    </div>
  </article>
</section>
