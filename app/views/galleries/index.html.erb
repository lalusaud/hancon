<% content_for :title, "Photo galleries | HaNCON" %>
<% content_for :header_theme, "dark" %>
<% content_for :meta_description, "Photo galleries from HaNCON community events." %>

<section class="py-10 text-white lg:py-14">
  <section class="mx-auto max-w-7xl px-6 lg:px-10">
    <%= link_to "← Back to HaNCON", root_path(anchor: "community"), class: "text-sm font-bold text-[#e7b85f] hover:text-white" %>
    <div class="mt-8 max-w-3xl">
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-[#e7b85f]">Community</p>
      <h1 class="mt-3 font-serif text-4xl font-semibold leading-tight tracking-[-0.03em] text-white sm:text-5xl">Photo galleries</h1>
    </div>
  </section>
</section>

<section class="bg-white py-12 text-[#182c29] lg:py-16">
  <section class="mx-auto max-w-7xl px-6 lg:px-10">
    <% if @galleries.any? %>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        <% @galleries.each do |gallery| %>
          <%= link_to gallery_path(gallery), class: "group overflow-hidden rounded-2xl border border-[#e2e5dc] bg-[#fbf8f2] transition hover:-translate-y-0.5 hover:shadow-md" do %>
            <% if gallery.photos.attached? %><%= image_tag gallery.featured_photo.variant(resize_to_limit: [960, 720]), loading: "lazy", class: "h-52 w-full object-cover transition group-hover:scale-[1.02]" %><% else %><div class="h-52 bg-[#e3eee5]"></div><% end %>
            <div class="p-5"><h2 class="font-bold text-[#173e35] group-hover:text-[#b84332]"><%= gallery.title %></h2><p class="mt-1 text-sm text-[#64746c]"><%= gallery.description %></p><span class="mt-4 inline-block text-sm font-bold text-[#17483e]"><%= pluralize(gallery.photos.size, "photo") %> →</span></div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="rounded-2xl border border-dashed border-[#cbd5cc] p-10 text-center text-[#64746c]">No galleries yet.</p>
    <% end %>
  </section>
</section>
