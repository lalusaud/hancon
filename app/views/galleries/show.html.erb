<% content_for :title, "#{@gallery.title} | HaNCON" %>
<% content_for :header_theme, "dark" %>

<section class="px-6 py-10 text-white lg:px-10 lg:py-14">
  <section class="mx-auto max-w-7xl">
    <%= link_to "← Back to HaNCON", root_path(anchor: "community"), class: "text-sm font-bold text-[#e7b85f] hover:text-white" %>
    <div class="mt-8 max-w-3xl">
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-[#e7b85f]">Photo gallery</p>
      <h1 class="mt-3 font-serif text-4xl font-semibold leading-tight tracking-[-0.03em] text-white sm:text-5xl"><%= @gallery.title %></h1>
      <% if @gallery.description.present? %><p class="mt-5 text-lg leading-8 text-[#e1e9e4]"><%= @gallery.description %></p><% end %>
    </div>

    <% if @gallery.photos.attached? %>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-controller="lightbox">
        <% @gallery.photos.each_with_index do |photo, photo_index| %>
          <button type="button" class="group block cursor-zoom-in text-left" data-action="lightbox#open" data-lightbox-index="<%= photo_index %>" data-lightbox-src="<%= url_for(photo) %>" data-lightbox-alt="<%= photo.filename %>" aria-label="View <%= photo.filename %> larger">
            <%= image_tag photo, class: "h-72 w-full rounded-2xl border border-[#e2e5dc] bg-white object-cover transition group-hover:brightness-95", alt: photo.filename.to_s %>
          </button>
        <% end %>

        <dialog aria-label="Gallery image preview" class="m-auto max-h-[92vh] max-w-[92vw] overflow-visible rounded-2xl bg-transparent p-0 backdrop:bg-black/80" data-lightbox-target="dialog" data-action="click->lightbox#closeOnBackdrop close->lightbox#clear keydown->lightbox#navigateWithArrow">
          <button type="button" class="fixed right-5 top-5 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-white text-2xl font-bold text-[#173e35] shadow-lg" data-action="lightbox#close" aria-label="Close image">×</button>
          <img class="max-h-[90vh] max-w-[90vw] rounded-xl object-contain shadow-2xl" data-lightbox-target="image" alt="">
          <button type="button" class="fixed left-5 top-1/2 z-10 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full bg-white text-2xl font-bold text-[#173e35] shadow-lg disabled:opacity-40" data-action="lightbox#previous" aria-label="Previous photo">‹</button>
          <button type="button" class="fixed right-5 top-1/2 z-10 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full bg-white text-2xl font-bold text-[#173e35] shadow-lg disabled:opacity-40" data-action="lightbox#next" aria-label="Next photo">›</button>
          <p class="fixed bottom-4 left-1/2 -translate-x-1/2 rounded-full bg-black/60 px-3 py-1 text-sm font-semibold text-white" data-lightbox-target="counter" aria-live="polite"></p>
        </dialog>
      </div>
    <% else %>
      <p class="mt-10 rounded-2xl border border-dashed border-white/30 p-10 text-center text-[#e1e9e4]">This gallery doesn’t have any photos yet.</p>
    <% end %>
  </section>
</section>
