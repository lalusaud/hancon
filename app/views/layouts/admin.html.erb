<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "HaNCON Admin" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "actiontext", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-screen bg-[#f6f5f0] text-[#182c29]">
    <header class="border-b border-[#e3e5dd] bg-white">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-6 py-4">
        <%= link_to admin_root_path, class: "font-extrabold tracking-[0.15em] text-[#17483e]" do %>
          HaNCON <span class="ml-2 text-xs font-semibold tracking-normal text-[#718078]">Content admin</span>
        <% end %>
        <nav class="flex flex-wrap items-center gap-4 text-sm font-semibold text-[#53645c]" aria-label="Admin navigation">
          <%= link_to "Overview", admin_root_path, class: "hover:text-[#b84332]" %>
          <%= link_to "News", admin_news_posts_path, class: "hover:text-[#b84332]" %>
          <%= link_to "Events", admin_events_path, class: "hover:text-[#b84332]" %>
          <%= link_to "Galleries", admin_galleries_path, class: "hover:text-[#b84332]" %>
          <%= link_to "View site", root_path, class: "ml-2 rounded-full border border-[#d4ddd5] px-4 py-2 text-[#17483e] hover:bg-[#f1f5f1]" %>
          <%= button_to "Sign out", session_path, method: :delete, class: "rounded-full bg-[#17483e] px-4 py-2 text-white hover:bg-[#10372f]" %>
        </nav>
      </div>
    </header>
    <main class="mx-auto max-w-7xl px-6 py-10">
      <% if notice.present? %><div class="mb-6 rounded-xl bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-800"><%= notice %></div><% end %>
      <% if alert.present? %><div class="mb-6 rounded-xl bg-red-50 px-4 py-3 text-sm font-semibold text-red-800"><%= alert %></div><% end %>
      <%= yield %>
    </main>
  </body>
</html>
