<header class="mx-auto flex w-full max-w-7xl items-center justify-between px-6 py-5 lg:px-10">
  <%= link_to root_path, class: "flex items-center gap-3", aria: { label: "HaNCON home" } do %>
    <span class="flex h-11 w-11 items-center justify-center rounded-full bg-[#b84332] text-sm font-black tracking-tight text-white">H</span>
    <span class="leading-tight">
      <span class="block text-lg font-extrabold tracking-[0.16em]">HaNCON</span>
      <span class="block text-[10px] font-semibold uppercase tracking-[0.13em] text-[#64746c]">Hamilton Nepalese Community</span>
    </span>
  <% end %>

  <nav class="hidden items-center gap-8 text-sm font-semibold text-[#40554d] md:flex" aria-label="Main navigation">
    <%= link_to "About", root_path(anchor: "about"), class: "transition hover:text-[#b84332]" %>
    <%= link_to "Programs", root_path(anchor: "programs"), class: "transition hover:text-[#b84332]" %>
    <%= link_to "Community", root_path(anchor: "community"), class: "transition hover:text-[#b84332]" %>
    <%= link_to "Contact", root_path(anchor: "contact"), class: "transition hover:text-[#b84332]" %>
    <% if authenticated? %>
      <%= link_to "Admin", admin_root_path, class: "ml-2 rounded-full border border-[#d4ddd5] px-4 py-2 text-[#17483e] hover:bg-[#f1f5f1]" %>
    <% end %>
  </nav>

  <%= link_to "Get involved ↗", root_path(anchor: "contact"), class: "rounded-full bg-[#17483e] px-5 py-3 text-sm font-bold text-white transition hover:bg-[#10372f]" %>
</header>
